# REFERENCE ONLY — reconstructed from `nmcli`, not the live file.
# Real: /etc/NetworkManager/system-connections/direct-link.nmconnection (root:root, 0600)
# Wired point-to-point. interface-name is the Tegra NIC on this carrier board.

[connection]
id=direct-link
type=ethernet
interface-name=enP8p1s0
autoconnect=true

[ethernet]

[ipv4]
method=manual
address1=192.168.50.1/24

[ipv6]
method=auto
